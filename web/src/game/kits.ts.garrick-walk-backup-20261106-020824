export function poses(kit: string, element?: string): Record<string, Pose> {
  const t = { ...COMMON, ...(TABLES[kit] ?? KNIGHT), ...(kit === "knight" && element === "light" ? ASTER_SWINGS : {}) };
  if (!t.charge) t.charge = t.mh_w ?? t.ash_w ?? KNIGHT.charge;
  return t;
}
