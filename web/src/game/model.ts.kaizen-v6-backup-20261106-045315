    mesh(this.chainBlade, new THREE.TubeGeometry(edgePath, 22, 0.0035, 4, false), bright);
    for (const yy of [0.272, 0.317])
      mesh(this.chainBlade, sphere(0.009, 8), brass, [0.018, yy, 0.018]);
